{
  "name": "contracts",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "build": "sh -c 'if command -v stellar >/dev/null 2>&1; then stellar contract build; else echo \"stellar-cli not installed; skipping Soroban contract build (handled by the CI unit-tests job via cargo)\"; fi'",
    "test": "cargo test",
    "test:integration": "../../tests/integration/run_e2e.sh",
    "dev": "cargo watch -x test",
    "format": "cargo fmt",
    "generate:bindings": "stellar contract bindings typescript --wasm contracts/linkora-contracts/target/wasm32-unknown-unknown/release/linkora_contracts.wasm --output src/ --overwrite"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "^13.0.0"
  },
  "devDependencies": {
    "typescript": "^5.8.3"
  }
}
